# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/supabase
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
supabase.exe

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Storybook — build output and cache (never commit)
/storybook-static/
.storybook-cache/
storybook-static

# Responsive screenshots — generated locally, never committed
/.screenshots/
/test-results/
/playwright-report/
playwright/.auth/

# Lighthouse trace artifacts — generated locally, never committed
/.artifacts/

# Component catalog generated reports — regenerate with npm run catalog:components
/scripts/governance/reports/*.json
/scripts/governance/reports/*.md

# Local Settings
.claude/