 "listingsConstraints": [
  {
   "name": "listings_description_length_check",
   "type": "c",
   "def": "CHECK (((description IS NULL) OR (char_length(description) <= 5000)))"
  },
  {
   "name": "listings_land_development_potential_check",
   "type": "c",
   "def": "CHECK ((land_development_potential = ANY (ARRAY['buildable'::text, 'change_of_use_required'::text, 'non_buildable'::text])))"
  },
  {
   "name": "listings_land_legal_status_check",
   "type": "c",
   "def": "CHECK ((land_legal_status = ANY (ARRAY['agricultural'::text, 'urban'::text, 'forest'::text, 'pasture'::text])))"
  },
  {
   "name": "listings_land_zoning_check",
   "type": "c",
   "def": "CHECK ((land_zoning = ANY (ARRAY['residential'::text, 'commercial'::text, 'tourism'::text, 'industrial'::text, 'mixed_use'::text])))"
  },
  {
   "name": "listings_lat_range_check",
   "type": "c",
   "def": "CHECK (((lat IS NULL) OR ((lat >= ('-90'::integer)::double precision) AND (lat <= (90)::double precision))))"
  },
  {
   "name": "listings_lng_range_check",
   "type": "c",
   "def": "CHECK (((lng IS NULL) OR ((lng >= ('-180'::integer)::double precision) AND (lng <= (180)::double precision))))"
  },
  {
   "name": "listings_offer_type_check",
   "type": "c",
   "def": "CHECK ((offer_type = ANY (ARRAY['owner'::text, 'agency'::text, 'developer'::text])))"
  },
  {
   "name": "listings_pkey",
   "type": "p",
   "def": "PRIMARY KEY (id)"
  },
  {
   "name": "listings_price_old_positive_check",
   "type": "c",
   "def": "CHECK (((price_old IS NULL) OR (price_old > (0)::numeric)))"
  },
  {
   "name": "listings_price_positive_check",
   "type": "c",
   "def": "CHECK ((price > (0)::numeric))"
  },
  {
   "name": "listings_public_id_key",
   "type": "u",
   "def": "UNIQUE (public_id)"
  },
  {
   "name": "listings_slug_key",
   "type": "u",
   "def": "UNIQUE (slug)"
  },
  {
   "name": "listings_title_length_check",
   "type": "c",
   "def": "CHECK (((char_length(btrim(title)) >= 5) AND (char_length(btrim(title)) <= 150)))"
  }
 ],
