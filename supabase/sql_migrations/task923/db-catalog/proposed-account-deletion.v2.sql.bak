-- PROPOSED (v2) — NOT APPLIED. Task 923 R43 (b): ONE complete deletion of an account for every role and every path (owner decisions D25, D27, D30-D35).
-- v2 = v1 + the three changes of Opus's review of 2026-10-19 (review-15/rv15-02-sql-review.md, kickoff section 24, R59): (a) the backfill leaves updated_at alone, (b) the name is the trigger's alone,
-- (c) the preflight compares the whole definition of the seven re-created keys. Generated by gen-sql-deletion.cjs from r9-61-deletion-schema-facts.txt and r14-03-capture.json.
-- The database was NOT changed by the executor.
-- Opus re-reviews this file, the owner approves its SHA-256 in writing, only then is it applied (and copied byte for byte to supabase/migrations/20261018010000_task923_account_deletion.sql).
--
-- WHAT IT DOES
--   1. Staff traces keep a NAME (D32): the 15 columns that name the staff member who acted (handled_by, replied_by, updated_by, actor_*, assigned_to, created_by_admin_id,
--      changed_by, reviewed_by) each get a sibling <column>_name, filled by one shared BEFORE INSERT OR UPDATE trigger and backfilled; their keys become ON DELETE SET NULL, so the record stays
--      with the name when the id goes. Five of them were NO ACTION and BLOCKED the deletion of any staff member who had ever acted; two (replied_by, actor_id) were NOT NULL and lose that.
--      The name is the TRIGGER's alone (R59 (b)): on INSERT it is set from the id (null when the id is null); on UPDATE it is recomputed when the id changes to another person, kept when the id
--      becomes null (the SET NULL of a deletion) and kept when the id is unchanged. A name supplied by a writer is never stored. The name is the person's name and last name, or the Auth
--      e-mail when both are empty. Each backfill runs BEFORE its trigger is created, so the trigger does not see it.
--   2. The person's own statistics go with the account (D33): listing_views.user_id and listing_contact_events.actor_user_id become ON DELETE CASCADE, and an AFTER DELETE
--      trigger on listing_views lowers listings.views_count by one for each deleted row whose listing still exists (one row is one increment), never below 0.
--   3. Reports and complaints stay, with the name (D33, D35): listing_reports.user_id and support_tickets.reported_user_id keep SET NULL and gain the same name column,
--      trigger and backfill. listing_inquiries holds the sender's typed name and e-mail already and is not touched. 17 columns in all keep a name.
--   4. Companies (D31): companies.created_by -> public.users ON DELETE CASCADE. Deleting the creator deletes the company; its other agents keep company_id null through
--      the existing SET NULL. Existing companies get created_by = null (no creator is recorded); Task 926 fills it for new companies (and must not record a staff member as the creator of a
--      company made for an agent: deleting that staff account would delete the agents' company).
--   5. Everything else already goes with the Auth user through the CASCADE keys (users.id -> auth.users CASCADE and the 22 CASCADE keys).
--   6. (v2, R59 (a)) email_templates and support_tickets carry BEFORE UPDATE triggers that set updated_at (trg_email_templates_updated_at, trg_support_tickets_updated_at). The two are
--      disabled around the backfills of those two tables, in this transaction, and enabled again: no template and no ticket gets a new "last updated" time at migration.
--   7. (v2, R59 (c)) The seven keys this file re-creates are re-created with the clauses of today's definition (no ON UPDATE, MATCH or DEFERRABLE clause today); the preflight compares each
--      captured definition (pg_get_constraintdef) and the rollback restores exactly that definition.
--
-- OUTSIDE THIS SQL (kickoff section 24, R60, owner decision D30): users.company_logo_url, verification_requests.document_url and the person's objects of the avatars bucket under
-- <user id>/ go with the account too; deleteAccount (R43 (c)) removes those files. This file does not touch them.

begin;
set local lock_timeout = '10s';
-- v2: the text of a constraint definition depends on the search_path that renders it; the capture and this preflight both render under this one
set local search_path = public, pg_temp;

-- ── 0. preflight: the keys must be exactly what was read ───────────────────────────────────────────────────────────────────────────────────
do $pre$
declare
  r record;
  want text[][] := array[
    ['contact_inquiries', 'contact_inquiries_handled_by_fkey', 'n'],
    ['contact_inquiry_replies', 'contact_inquiry_replies_replied_by_fkey', 'a'],
    ['email_templates', 'email_templates_updated_by_fkey', 'a'],
    ['history_clear_events', 'history_clear_events_actor_user_id_fkey', 'n'],
    ['pages', 'pages_updated_by_fkey', 'n'],
    ['report_actions', 'report_actions_actor_id_fkey', 'a'],
    ['role_permission_events', 'role_permission_events_actor_user_id_fkey', 'n'],
    ['role_permissions', 'role_permissions_updated_by_user_id_fkey', 'n'],
    ['site_footer', 'site_footer_updated_by_fkey', 'n'],
    ['support_ticket_events', 'support_ticket_events_actor_user_id_fkey', 'n'],
    ['support_tickets', 'support_tickets_assigned_to_fkey', 'n'],
    ['support_tickets', 'support_tickets_created_by_admin_id_fkey', 'n'],
    ['user_change_log', 'user_change_log_changed_by_fkey', 'a'],
    ['user_status_history', 'user_status_history_changed_by_fkey', 'a'],
    ['verification_requests', 'verification_requests_reviewed_by_fkey', 'n'],
    ['listing_reports', 'listing_reports_user_id_fkey', 'n'],
    ['support_tickets', 'support_tickets_reported_user_id_fkey', 'n'],
    ['listing_views', 'listing_views_user_id_fkey', 'n'],
    ['listing_contact_events', 'listing_contact_events_actor_user_id_fkey', 'n']
  ];
  want_def text[][] := array[
    ['contact_inquiry_replies', 'contact_inquiry_replies_replied_by_fkey', 'FOREIGN KEY (replied_by) REFERENCES auth.users(id)'],
    ['email_templates', 'email_templates_updated_by_fkey', 'FOREIGN KEY (updated_by) REFERENCES auth.users(id)'],
    ['report_actions', 'report_actions_actor_id_fkey', 'FOREIGN KEY (actor_id) REFERENCES users(id)'],
    ['user_change_log', 'user_change_log_changed_by_fkey', 'FOREIGN KEY (changed_by) REFERENCES users(id)'],
    ['user_status_history', 'user_status_history_changed_by_fkey', 'FOREIGN KEY (changed_by) REFERENCES users(id)'],
    ['listing_views', 'listing_views_user_id_fkey', 'FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL'],
    ['listing_contact_events', 'listing_contact_events_actor_user_id_fkey', 'FOREIGN KEY (actor_user_id) REFERENCES users(id) ON DELETE SET NULL']
  ];
  i int;
  have char;
  have_def text;
begin
  for i in 1 .. array_length(want, 1) loop
    select c.confdeltype into have from pg_constraint c where c.conrelid = ('public.' || want[i][1])::regclass and c.conname = want[i][2];
    if have is null or have::text <> want[i][3] then
      raise exception 'preflight failed: %.% has delete rule % (audited %)', want[i][1], want[i][2], coalesce(have::text, 'missing'), want[i][3];
    end if;
  end loop;
  -- v2 (R59 (c)): the whole definition of each re-created key, not only its delete rule
  for i in 1 .. array_length(want_def, 1) loop
    select pg_get_constraintdef(c.oid) into have_def from pg_constraint c where c.conrelid = ('public.' || want_def[i][1])::regclass and c.conname = want_def[i][2];
    if have_def is distinct from want_def[i][3] then
      raise exception 'preflight failed: %.% is defined as % (captured %)', want_def[i][1], want_def[i][2], coalesce(have_def, 'missing'), want_def[i][3];
    end if;
  end loop;
  -- v2 (R59 (a)): the two updated_at triggers exist, are not internal and are enabled (so that enabling them again restores today's state)
  if (select count(*) from pg_trigger t where t.tgrelid = 'public.email_templates'::regclass and t.tgname = 'trg_email_templates_updated_at' and not t.tgisinternal and t.tgenabled = 'O') <> 1 then
    raise exception 'preflight failed: trigger trg_email_templates_updated_at on public.email_templates is not the enabled trigger that was audited';
  end if;
  if (select count(*) from pg_trigger t where t.tgrelid = 'public.support_tickets'::regclass and t.tgname = 'trg_support_tickets_updated_at' and not t.tgisinternal and t.tgenabled = 'O') <> 1 then
    raise exception 'preflight failed: trigger trg_support_tickets_updated_at on public.support_tickets is not the enabled trigger that was audited';
  end if;
  if to_regprocedure('public.account_display_name(uuid)') is not null or to_regprocedure('public.set_actor_name()') is not null
     or exists (select 1 from information_schema.columns where table_schema = 'public' and table_name = 'companies' and column_name = 'created_by') then
    raise exception 'preflight failed: deletion objects already exist';
  end if;
end $pre$;

-- ── 1/3. the name that stays when the account goes ─────────────────────────────────────────────────────────────────────────────────────────
create function public.account_display_name(p_user uuid) returns text
language sql stable security definer set search_path = public, pg_temp as $$
  select coalesce(
    (select nullif(trim(concat_ws(' ', u.name, u.last_name)), '') from public.users u where u.id = p_user),
    (select a.email::text from auth.users a where a.id = p_user))
$$;
revoke all on function public.account_display_name(uuid) from public, anon, authenticated;
grant execute on function public.account_display_name(uuid) to service_role;

-- one shared trigger function (R59 (b)): the name column is the trigger's alone. INSERT: from the id, null when the id is null. UPDATE: recomputed when the id changes to another person;
-- kept when the id becomes null (the SET NULL of a deletion) or is unchanged. Whatever name a writer supplies is replaced.
create function public.set_actor_name() returns trigger
language plpgsql security definer set search_path = public, pg_temp as $$
declare
  v_id_col text := tg_argv[0];
  v_name_col text := tg_argv[1];
  v_new jsonb := to_jsonb(new);
  v_id uuid := nullif(v_new ->> v_id_col, '')::uuid;
  v_old jsonb;
  v_name text;
begin
  if tg_op = 'INSERT' then
    v_name := case when v_id is null then null else public.account_display_name(v_id) end;
  else
    v_old := to_jsonb(old);
    if v_id is null then
      v_name := v_old ->> v_name_col;                          -- the id becomes (or stays) null: the old name stays
    elsif (v_old ->> v_id_col) is not distinct from (v_new ->> v_id_col) then
      v_name := v_old ->> v_name_col;                          -- the id is unchanged: the old name stays
    else
      v_name := public.account_display_name(v_id);             -- the id changed to another person
    end if;
  end if;
  return jsonb_populate_record(new, jsonb_build_object(v_name_col, v_name));
end $$;
revoke all on function public.set_actor_name() from public, anon, authenticated;

-- the 17 name columns
alter table public.contact_inquiries add column "handled_by_name" text;
alter table public.contact_inquiry_replies add column "replied_by_name" text;
alter table public.email_templates add column "updated_by_name" text;
alter table public.history_clear_events add column "actor_user_id_name" text;
alter table public.pages add column "updated_by_name" text;
alter table public.report_actions add column "actor_id_name" text;
alter table public.role_permission_events add column "actor_user_id_name" text;
alter table public.role_permissions add column "updated_by_user_id_name" text;
alter table public.site_footer add column "updated_by_name" text;
alter table public.support_ticket_events add column "actor_user_id_name" text;
alter table public.support_tickets add column "assigned_to_name" text;
alter table public.support_tickets add column "created_by_admin_id_name" text;
alter table public.user_change_log add column "changed_by_name" text;
alter table public.user_status_history add column "changed_by_name" text;
alter table public.verification_requests add column "reviewed_by_name" text;
alter table public.listing_reports add column "user_id_name" text;
alter table public.support_tickets add column "reported_user_id_name" text;

-- the backfills run BEFORE the triggers exist (R59 (b)); the tables without an updated_at trigger first
update public.contact_inquiries set "handled_by_name" = public.account_display_name("handled_by") where "handled_by" is not null;
update public.contact_inquiry_replies set "replied_by_name" = public.account_display_name("replied_by") where "replied_by" is not null;
update public.history_clear_events set "actor_user_id_name" = public.account_display_name("actor_user_id") where "actor_user_id" is not null;
update public.pages set "updated_by_name" = public.account_display_name("updated_by") where "updated_by" is not null;
update public.report_actions set "actor_id_name" = public.account_display_name("actor_id") where "actor_id" is not null;
update public.role_permission_events set "actor_user_id_name" = public.account_display_name("actor_user_id") where "actor_user_id" is not null;
update public.role_permissions set "updated_by_user_id_name" = public.account_display_name("updated_by_user_id") where "updated_by_user_id" is not null;
update public.site_footer set "updated_by_name" = public.account_display_name("updated_by") where "updated_by" is not null;
update public.support_ticket_events set "actor_user_id_name" = public.account_display_name("actor_user_id") where "actor_user_id" is not null;
update public.user_change_log set "changed_by_name" = public.account_display_name("changed_by") where "changed_by" is not null;
update public.user_status_history set "changed_by_name" = public.account_display_name("changed_by") where "changed_by" is not null;
update public.verification_requests set "reviewed_by_name" = public.account_display_name("reviewed_by") where "reviewed_by" is not null;
update public.listing_reports set "user_id_name" = public.account_display_name("user_id") where "user_id" is not null;

-- R59 (a): email_templates and support_tickets keep their updated_at through the backfill (the two triggers are disabled, then enabled again, in this transaction)
alter table public.email_templates disable trigger trg_email_templates_updated_at;
alter table public.support_tickets disable trigger trg_support_tickets_updated_at;
update public.email_templates set "updated_by_name" = public.account_display_name("updated_by") where "updated_by" is not null;
update public.support_tickets set "assigned_to_name" = public.account_display_name("assigned_to") where "assigned_to" is not null;
update public.support_tickets set "created_by_admin_id_name" = public.account_display_name("created_by_admin_id") where "created_by_admin_id" is not null;
update public.support_tickets set "reported_user_id_name" = public.account_display_name("reported_user_id") where "reported_user_id" is not null;
alter table public.email_templates enable trigger trg_email_templates_updated_at;
alter table public.support_tickets enable trigger trg_support_tickets_updated_at;

-- the 17 name triggers
create trigger contact_inquiries_handled_by_name before insert or update on public.contact_inquiries for each row execute function public.set_actor_name('handled_by', 'handled_by_name');
create trigger contact_inquiry_replies_replied_by_name before insert or update on public.contact_inquiry_replies for each row execute function public.set_actor_name('replied_by', 'replied_by_name');
create trigger email_templates_updated_by_name before insert or update on public.email_templates for each row execute function public.set_actor_name('updated_by', 'updated_by_name');
create trigger history_clear_events_actor_user_id_name before insert or update on public.history_clear_events for each row execute function public.set_actor_name('actor_user_id', 'actor_user_id_name');
create trigger pages_updated_by_name before insert or update on public.pages for each row execute function public.set_actor_name('updated_by', 'updated_by_name');
create trigger report_actions_actor_id_name before insert or update on public.report_actions for each row execute function public.set_actor_name('actor_id', 'actor_id_name');
create trigger role_permission_events_actor_user_id_name before insert or update on public.role_permission_events for each row execute function public.set_actor_name('actor_user_id', 'actor_user_id_name');
create trigger role_permissions_updated_by_user_id_name before insert or update on public.role_permissions for each row execute function public.set_actor_name('updated_by_user_id', 'updated_by_user_id_name');
create trigger site_footer_updated_by_name before insert or update on public.site_footer for each row execute function public.set_actor_name('updated_by', 'updated_by_name');
create trigger support_ticket_events_actor_user_id_name before insert or update on public.support_ticket_events for each row execute function public.set_actor_name('actor_user_id', 'actor_user_id_name');
create trigger support_tickets_assigned_to_name before insert or update on public.support_tickets for each row execute function public.set_actor_name('assigned_to', 'assigned_to_name');
create trigger support_tickets_created_by_admin_id_name before insert or update on public.support_tickets for each row execute function public.set_actor_name('created_by_admin_id', 'created_by_admin_id_name');
create trigger user_change_log_changed_by_name before insert or update on public.user_change_log for each row execute function public.set_actor_name('changed_by', 'changed_by_name');
create trigger user_status_history_changed_by_name before insert or update on public.user_status_history for each row execute function public.set_actor_name('changed_by', 'changed_by_name');
create trigger verification_requests_reviewed_by_name before insert or update on public.verification_requests for each row execute function public.set_actor_name('reviewed_by', 'reviewed_by_name');
create trigger listing_reports_user_id_name before insert or update on public.listing_reports for each row execute function public.set_actor_name('user_id', 'user_id_name');
create trigger support_tickets_reported_user_id_name before insert or update on public.support_tickets for each row execute function public.set_actor_name('reported_user_id', 'reported_user_id_name');

-- the 15 staff keys become SET NULL (five were NO ACTION; two columns were NOT NULL)
-- contact_inquiries.handled_by is SET NULL already
alter table public.contact_inquiry_replies alter column "replied_by" drop not null;
alter table public.contact_inquiry_replies drop constraint "contact_inquiry_replies_replied_by_fkey", add constraint "contact_inquiry_replies_replied_by_fkey" foreign key ("replied_by") references auth.users(id) on delete set null;
alter table public.email_templates drop constraint "email_templates_updated_by_fkey", add constraint "email_templates_updated_by_fkey" foreign key ("updated_by") references auth.users(id) on delete set null;
-- history_clear_events.actor_user_id is SET NULL already
-- pages.updated_by is SET NULL already
alter table public.report_actions alter column "actor_id" drop not null;
alter table public.report_actions drop constraint "report_actions_actor_id_fkey", add constraint "report_actions_actor_id_fkey" foreign key ("actor_id") references public.users(id) on delete set null;
-- role_permission_events.actor_user_id is SET NULL already
-- role_permissions.updated_by_user_id is SET NULL already
-- site_footer.updated_by is SET NULL already
-- support_ticket_events.actor_user_id is SET NULL already
-- support_tickets.assigned_to is SET NULL already
-- support_tickets.created_by_admin_id is SET NULL already
alter table public.user_change_log drop constraint "user_change_log_changed_by_fkey", add constraint "user_change_log_changed_by_fkey" foreign key ("changed_by") references public.users(id) on delete set null;
alter table public.user_status_history drop constraint "user_status_history_changed_by_fkey", add constraint "user_status_history_changed_by_fkey" foreign key ("changed_by") references public.users(id) on delete set null;
-- verification_requests.reviewed_by is SET NULL already

-- ── 2. the person's own statistics ───────────────────────────────────────────────────────────────────────────────────────────────────────────
alter table public.listing_views drop constraint "listing_views_user_id_fkey", add constraint "listing_views_user_id_fkey" foreign key ("user_id") references public.users(id) on delete cascade;
alter table public.listing_contact_events drop constraint "listing_contact_events_actor_user_id_fkey", add constraint "listing_contact_events_actor_user_id_fkey" foreign key ("actor_user_id") references public.users(id) on delete cascade;

create function public.lower_views_count_on_view_delete() returns trigger
language plpgsql security definer set search_path = public, pg_temp as $$
begin
  update public.listings set views_count = greatest(views_count - 1, 0) where id = old.listing_id;
  return old;
end $$;
revoke all on function public.lower_views_count_on_view_delete() from public, anon, authenticated;
create trigger listing_views_lower_count after delete on public.listing_views for each row execute function public.lower_views_count_on_view_delete();

-- ── 4. companies ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
alter table public.companies add column created_by uuid null references public.users(id) on delete cascade;
create index companies_created_by on public.companies (created_by);

notify pgrst, 'reload schema';
commit;
