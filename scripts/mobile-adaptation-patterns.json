{
  "version": 3,
  "mobileGate": {
    "compactRange": "<640px",
    "transition": "640px",
    "source": "src/design-system/mantine/theme.ts"
  },
  "mantine": {
    "package": "@mantine/core",
    "versionRange": "^8.3.18",
    "projectAuthority": {
      "source": "docs/mantine-responsive-design-system.md",
      "rule": "Mantine supplies responsive mechanism, interaction, and accessibility behavior; this registry supplies only the required semantic compact outcome and verification."
    },
    "mechanisms": [
      { "id": "responsive-props", "title": "Mantine responsive prop system", "url": "https://mantine.dev/styles/responsive/" },
      { "id": "visibility-props", "title": "Mantine visibleFrom and hiddenFrom", "url": "https://mantine.dev/styles/responsive/" },
      { "id": "app-shell-responsive", "title": "Mantine AppShell responsive navbar and header", "url": "https://mantine.dev/core/app-shell/?t=props" },
      { "id": "media-query-exception", "title": "Mantine useMediaQuery exception with SSR behavior", "url": "https://mantine.dev/hooks/use-media-query/" }
    ]
  },
  "standards": [
    { "id": "w3c-reflow", "title": "W3C WCAG 2.2 - Reflow", "url": "https://www.w3.org/WAI/WCAG21/Understanding/reflow" },
    { "id": "w3c-meaningful-sequence", "title": "W3C WCAG 2.2 - Meaningful Sequence", "url": "https://www.w3.org/WAI/WCAG22/Understanding/meaningful-sequence" },
