         env:
           REVIEW_LEDGER_BASE_SHA: ${{ github.event.pull_request.base.sha }}
         run: npm run check:review-ledger -- --ci
 
+      # On a direct push to main there is no PR base to diff, and task-design / NEEDS REVISION commits
