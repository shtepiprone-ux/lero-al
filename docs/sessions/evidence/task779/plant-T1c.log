                key={type}
                type=\"button\"
                variant={listingType === type ? 'filled' : 'default'}
                onClick={() => updateParams({ type: type || null })}
              >
                {type === '' ? tc('all') : t(type)}
              </Button>
            ))}
          </Group>

          <Divider orientation=\"vertical\" color=\"gray.3\" />

          {/* Property type */}
          <MantineCombobox
            options={propertyTypeOptions}
            value={propertyType}
