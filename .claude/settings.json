  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/quality/agent-check.mjs",
              "start"
            ],
            "timeout": 60,
            "statusMessage": "Record the files already changed"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/quality/agent-check.mjs",
              "post"
            ],
            "timeout": 120,
            "statusMessage": "File checks and ESLint on the written file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/quality/agent-check.mjs",
              "stop"
            ],
            "timeout": 900,
            "statusMessage": "Checks of every file changed in this session"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/quality/agent-check.mjs",
              "stop"
            ],
            "timeout": 900,
            "statusMessage": "Checks of every file changed in this session"
          }
        ]
      }
    ]
  },
