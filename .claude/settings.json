{
  "permissions": {
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git rm *)",
      "Bash(git apply *)",
      "Bash(git clean *)",
      "Bash(git config *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git restore *)",
      "PowerShell(git checkout *)",
      "PowerShell(git stash *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git rm *)",
      "PowerShell(git apply *)",
      "PowerShell(git clean *)",
      "PowerShell(git config *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/workflow-gates/security-hook.mjs"
            ],
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Validating saved task security contract"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NonInteractive",
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/phase-write-gate.ps1"
            ],
            "timeout": 5,
            "statusMessage": "Verifying required phase preflight",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NonInteractive",
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-mutating-git.ps1"
            ],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/workflow-gates/session-role.mjs"
            ],
            "timeout": 5,
            "onFailure": "block",
            "statusMessage": "Resolving the current workflow role"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NonInteractive",
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/sonnet-executor-bootstrap.ps1",
              "-Part",
              "1"
            ],
            "timeout": 5,
            "statusMessage": "Loading Sonnet executor workflow",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/workflow-gates/code-check.mjs"
            ],
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking written code"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NonInteractive",
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/orchestrator-router.ps1",
              "-Part",
              "1"
            ],
            "timeout": 5,
            "statusMessage": "Routing Opus task/review workflow",
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/workflow-gates/push-safety.mjs"],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Checking exact-commit push evidence for every model"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/workflow-gates/security-hook.mjs"
            ],
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Validating saved task security contract"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NonInteractive",
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/orchestrator-response-gate.ps1"
            ],
            "timeout": 10,
            "statusMessage": "Golden Rules gate (GR-5 / GR-6)",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/workflow-gates/code-check.mjs"
            ],
            "timeout": 300,
            "onFailure": "block",
            "statusMessage": "Checking written code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/workflow-gates/code-check.mjs"
            ],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Checking written code"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/workflow-gates/code-check.mjs"
            ],
            "timeout": 300,
            "onFailure": "block",
            "statusMessage": "Checking written code"
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/workflow-gates/session-role.mjs"
            ],
            "timeout": 5,
            "onFailure": "block",
            "statusMessage": "Resolving the current workflow role"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "browser-use@claude-plugins-official": true
  },
  "claudeMdExcludes": [
    "**/.claude/rules/create/**",
    "**/.claude/rules/execute/**",
    "**/.claude/rules/review/**",
    "**/.claude/rules/shared/**"
  ],
  "disableAllHooks": false
}
