{
  "roots": ["src", "scripts", ".claude/hooks", ".claude/settings.json", "messages", ".storybook", "tsconfig.json", "package.json", "next.config.ts", "vitest.config.ts", "vitest.integration.config.ts", "eslint.config.mjs", "postcss.config.mjs", "sentry.edge.config.ts", "sentry.server.config.ts", "package-lock.json", ".npmrc", "supabase/migrations", ".github/workflows", "CLAUDE.md", "AGENTS.md", ".codex", ".claude/rules", ".claude/skills", ".claude/agents"],
  "timeoutMs": { "write": 50000, "stop": 240000 },
  "tailLines": 40,
  "quieting": [
    { "paths": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs", "**/*.selftest.mjs"], "pattern": "\\b(?:it|test|describe|suite)\\.(?:skip|todo|fails)\\b|\\b(?:xit|xtest|xdescribe)\\(", "what": "a test switched off" },
    { "paths": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs"], "pattern": "\\.(?:toBeDefined|toBeTruthy|toBeFalsy)\\(|expect\\.anything\\(", "what": "an assertion that accepts almost anything" },
    { "paths": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs"], "pattern": "\\bexpect\\(", "what": "assertions removed", "fewer": true },
    { "paths": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs"], "pattern": "\\bvi\\.(?:mock|spyOn|stubGlobal)\\(", "what": "a new mock, which may replace what the test exists to exercise" },
    { "paths": ["**/*.selftest.mjs"], "pattern": "\\bassert\\.", "what": "assertions removed", "fewer": true },
    { "paths": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts"], "pattern": "\\bas any\\b|:\\s*any\\b|<any>|\\bas unknown as\\b|@ts-(?:ignore|nocheck|expect-error)", "what": "a type check switched off" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.css", "scripts/**/*.mjs", "scripts/**/*.ts"], "pattern": "eslint-disable|design-tokens-allow:", "what": "a rule switched off" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx", "messages/*.json"], "pattern": "[\\u0420\\u0421][\\u0402\\u0403\\u0409-\\u040C\\u040F\\u0452\\u0453\\u0459-\\u045C\\u045F]", "what": "garbled Cyrillic, which the mojibake gate does not know" }
  ],
  "secure": [
    { "paths": ["**/*"], "refuse": true, "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "what": "a private key (CWE-798). Remove it and rotate it: it is now in this session's context" },
    { "paths": ["**/*"], "refuse": true, "pattern": "\\b(?:sk_live_[0-9a-zA-Z]{16,}|ghp_[0-9A-Za-z]{30,}|github_pat_[0-9A-Za-z_]{30,}|AKIA[0-9A-Z]{16}|sbp_[0-9a-f]{30,}|xox[baprs]-[0-9A-Za-z-]{20,})", "what": "a live credential (CWE-798). Remove it and rotate it" },
    { "paths": ["**/*"], "refuse": true, "pattern": "\\beyJ[A-Za-z0-9_-]{20,}\\.eyJ[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}", "what": "a signed token, such as a Supabase key (CWE-798). Remove it and rotate it" },
    { "paths": ["**/*"], "refuse": true, "pattern": "[\\u202A-\\u202E\\u2066-\\u2069]", "what": "an invisible text-direction character, which shows a reader other code than runs (CWE-1007)" },
    { "paths": ["**/*"], "refuse": true, "pattern": "NEXT_PUBLIC_[A-Z0-9_]*(?:SECRET|SERVICE_ROLE|PRIVATE|PASSWORD)", "what": "a secret under NEXT_PUBLIC_, which the build sends to every browser (CWE-200)" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "dangerouslySetInnerHTML|\\.innerHTML\\s*=|document\\.write\\(", "what": "HTML written without encoding (CWE-79)" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.mjs"], "pattern": "\\beval\\(|new Function\\(", "what": "text run as code (CWE-95)" },
    { "paths": ["src/**/*.ts", "scripts/**/*.mjs"], "pattern": "\\bexec(?:Sync)?\\(\\s*`|\\bshell:\\s*true", "what": "a command built as text (CWE-78)" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "\\.(?:rpc|from|or|filter|textSearch)\\(\\s*`[^`]*\\$\\{|\\.raw\\(|\\bSELECT\\b[^'\"`]*\\$\\{", "what": "a query built from text (CWE-89)" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "\\bredirect\\(\\s*(?:req|request|params|searchParams|url|next|returnTo)\\b|NextResponse\\.redirect\\(\\s*(?:req|request|params|searchParams|next|returnTo)\\b", "what": "a redirect to a place the request names (CWE-601)" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "\\bfetch\\(\\s*(?:req|request|params|searchParams|url|input|body)\\b", "what": "a request to a place the caller names (CWE-918)" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "Math\\.random\\(\\)", "what": "a random value no attacker may guess must not come from Math.random (CWE-338)" },
    { "paths": ["src/**/*.ts", "scripts/**/*.mjs"], "pattern": "createHash\\(\\s*['\"](?:md5|sha1)['\"]", "what": "a broken hash, if it protects anything (CWE-327)" },
    { "paths": ["src/**/*.ts", "scripts/**/*.mjs"], "pattern": "rejectUnauthorized:\\s*false|NODE_TLS_REJECT_UNAUTHORIZED", "what": "certificate checks switched off (CWE-295)" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "console\\.\\w+\\([^)]*\\b(?:password|passwd|token|secret|cookie|authorization)\\b", "what": "something secret written to a log (CWE-532)" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx"], "flags": "m", "pattern": "^\\s*['\"]use server['\"]", "what": "a new Server Action file: each export is a POST anyone can call, so validate input and authorize the exact object on the server" },
    { "paths": ["src/**/route.ts", "src/**/route.tsx"], "pattern": "export\\s+(?:async\\s+)?(?:function|const)\\s+(?:GET|POST|PUT|PATCH|DELETE)\\b", "what": "a new HTTP entry point: name its audience and test it by calling it directly" },
    { "paths": ["src/**/*.ts", "src/**/*.tsx"], "pattern": "createAdminClient\\(|SUPABASE_SERVICE_ROLE_KEY", "what": "the database's row rules are bypassed here, so this code alone authorizes" },
    { "paths": ["supabase/migrations/*.sql"], "flags": "i", "pattern": "security\\s+definer", "what": "a function that runs with its owner's rights: it needs its own checks and a fixed search_path (CWE-250)" },
    { "paths": ["supabase/migrations/*.sql"], "flags": "i", "pattern": "\\bgrant\\b[^;]*\\bto\\s+(?:anon|public|authenticated)\\b|disable\\s+row\\s+level\\s+security|using\\s*\\(\\s*true\\s*\\)", "what": "access widened in the database (CWE-284)" },
    { "paths": ["package.json"], "pattern": "\"(?:pre|post)?install\"\\s*:|\"prepare\"\\s*:|\"prebuild\"\\s*:", "what": "a script that runs by itself on install or build" },
    { "paths": [".npmrc", ".github/workflows/*", "CLAUDE.md", "AGENTS.md", ".codex/*", ".claude/rules/**/*", ".claude/skills/**/*", ".claude/agents/*", ".claude/settings.json", ".claude/hooks/*", "scripts/workflow-gates/audit-baseline.json", "scripts/workflow-gates/code-check.json"], "changed": true, "what": "this file steers every later agent or runs by itself, so its whole diff needs an independent reader" }
  ],
  "dependencies": { "minPackageAgeDays": 30, "minVersionAgeDays": 7 },
  "mutation": {
    "timeoutMs": 120000,
    "hookMs": 285000,
    "perMutantMs": 20000,
    "concurrency": 3,
    "shown": 8,
    "skip": ["**/*.d.ts", "**/*.stories.tsx", "**/*.stories.ts", "src/tests/**/*", "**/*.selftest.mjs", "scripts/workflow-gates/eslint.config.mjs", "scripts/workflow-gates/mutation-vitest.config.mjs", "scripts/__tests__/**/*"],
    "rows": [
      { "paths": ["src/**/*.test.ts", "src/**/*.test.tsx", "scripts/**/*.test.ts", "scripts/**/*.test.mjs"], "test": true, "run": "node node_modules/vitest/vitest.mjs run {file} --bail=1 --allowOnly=false --reporter=dot --config scripts/workflow-gates/mutation-vitest.config.mjs" },
      { "paths": ["scripts/workflow-gates/*.mjs"], "needs": "scripts/workflow-gates/{stem}.selftest.mjs", "priority": 1, "concurrency": 1, "run": "node --test scripts/workflow-gates/{stem}.selftest.mjs" },
      { "paths": ["scripts/workflow-gates/*.mjs"], "priority": 2, "concurrency": 1, "run": "node scripts/workflow-gates/selftests.mjs" },
      { "paths": ["src/**/*.ts", "src/**/*.tsx", "scripts/*.mjs", "scripts/*.js", "scripts/*.cjs", "scripts/lib/**/*.mjs", "scripts/governance/**/*.mjs", "scripts/rendered-state-census/**/*.mjs", "scripts/**/*.ts"], "run": "node node_modules/vitest/vitest.mjs related {file} --run --bail=1 --passWithNoTests --allowOnly=false --reporter=dot --config scripts/workflow-gates/mutation-vitest.config.mjs" },
      { "paths": ["scripts/**/*.mjs", "scripts/**/*.js", "scripts/**/*.cjs"], "priority": 2, "concurrency": 1, "run": "node scripts/workflow-gates/selftests.mjs" }
    ]
  },
  "rows": [
    {
      "paths": ["src/**/*.ts", "src/**/*.tsx"],
      "write": [
        "node node_modules/eslint/bin/eslint.js --quiet {files}",
        "node scripts/check-file-integrity.mjs --files {files}",
        "node node_modules/typescript/bin/tsc --noEmit --pretty false"
      ],
      "stop": ["node node_modules/vitest/vitest.mjs related {files} --run --passWithNoTests --allowOnly=false --reporter=dot"]
    },
    {
      "paths": ["src/**/*.tsx", "src/**/*.css"],
      "write": ["node scripts/check-file-integrity.mjs --files {files}"],
      "stop": [{ "run": "node scripts/check-design-tokens.mjs --strict", "namesFile": true }]
    },
    {
      "paths": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.css", "messages/*.json"],
      "write": [],
      "stop": [{ "run": "node scripts/check-mojibake.mjs", "namesFile": true, "folders": ["docs/", "src/", "messages/", "tasks/", "scripts/"] }]
    },
    {
      "paths": ["scripts/**/*.mjs", "scripts/**/*.js", "scripts/**/*.cjs"],
      "write": ["node scripts/check-file-integrity.mjs --files {files}"],
      "stop": ["node scripts/workflow-gates/selftests.mjs"]
    },
    {
      "paths": ["scripts/*.mjs", "scripts/*.js", "scripts/*.cjs", "scripts/lib/**/*.mjs", "scripts/governance/**/*.mjs", "scripts/rendered-state-census/**/*.mjs"],
      "write": [],
      "stop": ["node node_modules/vitest/vitest.mjs related {files} --run --passWithNoTests --allowOnly=false --reporter=dot"]
    },
    {
      "paths": ["scripts/**/*.ts"],
      "write": [
        "node scripts/check-file-integrity.mjs --files {files}",
        "node node_modules/typescript/bin/tsc --noEmit --pretty false"
      ],
      "stop": ["node node_modules/vitest/vitest.mjs related {files} --run --passWithNoTests --allowOnly=false --reporter=dot"]
    },
    {
      "paths": ["scripts/**/*.json"],
      "write": ["node scripts/check-file-integrity.mjs --files {files}"],
      "stop": ["node scripts/workflow-gates/selftests.mjs", "node scripts/workflow-gates/check-workflow.mjs"]
    },
    {
      "paths": ["scripts/workflow-gates/security-hook.mjs"],
      "write": [],
      "stop": ["node scripts/workflow-gates/hook-differential.mjs"]
    },
    {
      "paths": [".claude/hooks/*.ps1"],
      "write": ["powershell -NoProfile -Command \"$e=$null;[void][System.Management.Automation.Language.Parser]::ParseFile((Resolve-Path '{file}'),[ref]$null,[ref]$e); if($e){$e[0].Message;exit 1}\""],
      "stop": ["node scripts/workflow-gates/check-workflow.mjs"]
    },
    {
      "paths": [".claude/settings.json"],
      "write": ["node scripts/check-file-integrity.mjs --files {files}"],
      "stop": ["node scripts/workflow-gates/check-workflow.mjs"]
    },
    {
      "paths": ["messages/*.json"],
      "write": ["node scripts/check-file-integrity.mjs --files {files}"],
      "stop": ["node scripts/check-i18n-parity.mjs"]
    },
    {
      "paths": ["tsconfig.json", "package.json"],
      "write": [
        "node scripts/check-file-integrity.mjs --files {files}",
        "node node_modules/typescript/bin/tsc --noEmit --pretty false"
      ],
      "stop": []
    },
    {
      "paths": ["package.json", "package-lock.json"],
      "write": [],
      "stop": ["node scripts/workflow-gates/dependency-check.mjs"]
    },
    {
      "paths": [".github/workflows/*", ".npmrc", "CLAUDE.md", "AGENTS.md", ".codex/*", ".claude/rules/**/*", ".claude/skills/**/*", ".claude/agents/*"],
      "write": [],
      "stop": ["node scripts/workflow-gates/check-workflow.mjs"]
    },
    {
      "paths": ["supabase/migrations/*.sql"],
      "write": ["node scripts/check-file-integrity.mjs --files {files}"],
      "stop": []
    },
    {
      "paths": ["next.config.ts", "sentry.*.config.ts", "vitest.integration.config.ts", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
      "write": [
        "node node_modules/eslint/bin/eslint.js --quiet {files}",
        "node scripts/check-file-integrity.mjs --files {files}",
        "node node_modules/typescript/bin/tsc --noEmit --pretty false"
      ],
      "stop": []
    },
    {
      "paths": ["vitest.config.ts"],
      "write": [
        "node scripts/check-file-integrity.mjs --files {files}",
        "node node_modules/typescript/bin/tsc --noEmit --pretty false"
      ],
      "stop": ["node node_modules/vitest/vitest.mjs list --filesOnly"]
    },
    {
      "paths": ["eslint.config.mjs"],
      "write": [
        "node scripts/check-file-integrity.mjs --files {files}",
        "node node_modules/eslint/bin/eslint.js --quiet {files}"
      ],
      "stop": []
    },
    {
      "paths": ["postcss.config.mjs"],
      "write": ["node scripts/check-file-integrity.mjs --files {files}"],
      "stop": []
    }
  ]
}
