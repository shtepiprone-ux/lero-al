-- PROPOSED (v6) — NOT APPLIED. Executor draft for Opus re-review and the owner's approval of THIS file's SHA-256; the database was NOT changed by the executor.
-- v4 = v3 + the eight changes of Opus's review of 2026-10-18 (review-8/rv8-05-sql-review.md).
-- v5 = v4 + the two changes of Opus's review of 2026-10-19 (review-15/rv15-02-sql-review.md, R58): change 9 the view public_user_profiles, change 10 the search_path of six more functions.
-- v6 = v5 + the one change of Opus's review of 2026-10-19 (review-16/rv16-02-sql-review.md, R61): the view's condition checks a session and trusts a server role (change 9, item 5 below).
-- Generated by gen-sql.cjs from catalog.json / fingerprint.json / r14-03-capture.json (a read-only capture of the approved development database).
--
-- WHAT IT CLOSES (every row has a separate check in rls-harness.cjs):
--   S59/S60  users: role, is_verified, status, block_reason, suspended_until, deleted_at, public_id, id  — BEFORE INSERT OR UPDATE guard (change 5)
--   DBR-1    users: the initial role / verified flag came from sign-up metadata (handle_new_user) — now always 'user' / false
--   S61      listings: is_premium, premium_until, views_count, expires_at, public_id, user_id, status  — session roles can no longer write them
--   S62      record_listing_view: callable only by service_role, honours the server-set user id, public statuses only, per-fingerprint advisory lock, returns boolean
--   S63      record_recently_viewed: cap clamped 1..100, anon cannot call
--   S64      get_listing_owner_contact: per-person daily quota enforced INSIDE the function. The number is an OWNER decision: NULL (= unlimited) until the owner sets it.
--   S65      TRUNCATE revoked from anon / authenticated
--
-- THE FOUR CHANGES OF THE OWNER'S DECISIONS D25-D29 (the access of EVERY account, whatever its role)
--   change 1  search_path = public, pg_temp in the four SECURITY DEFINER functions rewritten here (PostgreSQL: "Writing SECURITY DEFINER Functions Safely"); the six others: change 10.
--   change 2  caller_is_active() is true ONLY when the profile row exists, deleted_at is null, the status gives access (active, or blocked with an ended
--             suspension; inactive blocks) AND the JWT's session_id names a row of auth.sessions (Supabase: "User sessions"). A missing row is NO access.
--   change 3  caller_is_admin() also requires caller_is_active(): a blocked or deleted administrator's still-valid token is trusted by no guard.
--   change 4  a RESTRICTIVE select policy joins the restrictive write policies on every table 'authenticated' can read: a ban, a block and a deletion take
--             effect on the next database request (D26: "0 seconds"), not after the token lifetime. CODE CHANGE IN THE SAME RELEASE: getBlockedError reads through
--             the service role and treats a missing row as no access (src/lib/auth/blockCheck.ts, done in Task 923 R44 (d)).
--   change 7  file storage too: restrictive select / insert / update / delete policies to authenticated on storage.objects.
--   change 8  the inactivity state (D28): caller_access_state() answers active / restorable / none; restore_inactive_account() makes the writes of
--             src/app/api/presence/route.ts for auth.uid() when the state is restorable (deleted_at within 90 days, status inactive, a live session).
--   change 9  (v5, R58 (a); condition v6, R61) the view public_user_profiles is a definer view (security_invoker=false): it ignores the RLS of public.users, so a blocked, deleted or signed-out-elsewhere
--             account kept a read path that a guest does not have (seller name, company, avatar, has_phone). It is recreated with the same columns, owner, options and grants and the condition
--             current_user not in ('authenticated', 'anon') or (select public.caller_is_active()) (the guards' own test: a session is checked, a trusted server role is not); the preflight checks
--             the md5 of the captured definition, its ACL and its options; the rollback restores the captured definition.
--   change 10 (v5, R58 (b)) search_path = <current list>, pg_temp on the six SECURITY DEFINER functions v4 left as they were, no body change: clear_user_history,
--             handle_new_user_notifications, listing_contact_events_set_owner, process_saved_search_notify (public), admin_search_users_by_email (auth, public), rls_auto_enable (pg_catalog).
--             The preflight checks each current setting; the rollback restores it.
--
-- OWNER DECISIONS (verbatim in the session log): D-status (an owner cannot publish), D-blocked (a blocked person has no access), D25-D29.
--
-- STILL OPEN
--   D-quota    the number for owner_contact_daily_limit() (NULL = unlimited, today) and the text of the 54000 'rate_limited' error.
--
-- NOT BEHAVIOUR-NEUTRAL (Opus: confirm each)
--   1. record_listing_view now returns boolean; a view with neither a user id nor a fingerprint is no longer counted; it is callable by service_role only.
--   2. Sign-up through the public API can no longer choose a role; the admin panel is unaffected (it sets the role afterwards with service_role).
--   3. A blocked / inactive / deleted person, a missing profile row and a session that no longer exists lose EVERY table the signed-in role can read or write and
--      the owner-contact, recently-viewed and avatar storage paths. Reads are refused too (change 4): the application must not read the person's own status row
--      with the person's session (getBlockedError uses the service role since R44 (d)).
--   4. users INSERT by a session is refused unless it is exactly a plain new user (no policy allows it today; the guard no longer depends on that staying true).
--   5. (v5, rewritten in v6) public_user_profiles returns no row to a blocked, deleted or ended-session account (the 'authenticated' / 'anon' roles fail caller_is_active()), and every other role reads it
--      as today: service_role and the owner pass the first test of the condition, which is the guards' own (section 3). src/app/admin/listings/[id]/preview/page.tsx:45 reads the view through
--      createAdminClient() (a service-role client) and keeps its owner card. Inside a view that is not security_invoker, current_user is the CALLER, not the view's owner (r15-02-view-probe.txt:
--      under set local role authenticated the definer view answered "authenticated", under service_role "service_role").

begin;
set local lock_timeout = '10s';
-- v5: the text of a view definition depends on the search_path that renders it; the capture and this preflight both render under this one
set local search_path = public, pg_temp;

-- ── 0. preflight: refuse to run against a schema that is not the one that was audited ──────────────────────────────────────────────────────
do $pre$
declare
  want jsonb := '{
    "public.handle_new_user()": "8d5b26128233591638f0bd468210e760",
    "public.record_listing_view(uuid,uuid,text)": "4c94f50300a8e8dfdd0d33a5283f4a61",
    "public.record_recently_viewed(uuid,integer)": "c259cab547f4f661c5c4b05db6831ef2",
    "public.get_listing_owner_contact(uuid)": "54a6b92e49ddc375144d49b9e3646577"
  }';
  k text; got text;
begin
  for k in select jsonb_object_keys(want) loop
    got := md5(pg_get_functiondef(k::regprocedure));
    if got is distinct from want->>k then
      raise exception 'preflight failed: % changed since the audit (have %, audited %)', k, got, want->>k;
    end if;
  end loop;
  if (select count(*) from pg_trigger t where t.tgrelid = 'auth.users'::regclass and not t.tgisinternal) <> 1 then
    raise exception 'preflight failed: auth.users trigger set changed';
  end if;
  -- v5 (R58 (a)): the view is exactly the one the capture recorded (definition md5, ACL, options)
  if md5(pg_get_viewdef('public.public_user_profiles'::regclass, true)) is distinct from '2c5211f930d54d58322702d27a6d6e87' then
    raise exception 'preflight failed: public.public_user_profiles changed since the capture (definition md5)';
  end if;
  if (select c.relacl::text from pg_class c where c.oid = 'public.public_user_profiles'::regclass) is distinct from '{postgres=arwdDxtm/postgres,service_role=arwdDxtm/postgres,authenticated=r/postgres}' or (select c.reloptions from pg_class c where c.oid = 'public.public_user_profiles'::regclass) is distinct from array['security_invoker=false']::text[] then
    raise exception 'preflight failed: the grants or the options of public.public_user_profiles changed since the capture';
  end if;
  -- v5 (R58 (b)): each of the six functions has exactly the settings the capture recorded
  if (select p.proconfig from pg_proc p where p.oid = to_regprocedure('public.clear_user_history(text, uuid, uuid, uuid)')) is distinct from array['search_path=public']::text[] then
    raise exception 'preflight failed: the settings of public.clear_user_history(text, uuid, uuid, uuid) changed since the capture';
  end if;
  if (select p.proconfig from pg_proc p where p.oid = to_regprocedure('public.handle_new_user_notifications()')) is distinct from array['search_path=public']::text[] then
    raise exception 'preflight failed: the settings of public.handle_new_user_notifications() changed since the capture';
  end if;
  if (select p.proconfig from pg_proc p where p.oid = to_regprocedure('public.listing_contact_events_set_owner()')) is distinct from array['search_path=public']::text[] then
    raise exception 'preflight failed: the settings of public.listing_contact_events_set_owner() changed since the capture';
  end if;
  if (select p.proconfig from pg_proc p where p.oid = to_regprocedure('public.process_saved_search_notify(timestamp with time zone)')) is distinct from array['search_path=public']::text[] then
    raise exception 'preflight failed: the settings of public.process_saved_search_notify(timestamp with time zone) changed since the capture';
  end if;
  if (select p.proconfig from pg_proc p where p.oid = to_regprocedure('public.admin_search_users_by_email(text)')) is distinct from array['search_path=auth, public']::text[] then
    raise exception 'preflight failed: the settings of public.admin_search_users_by_email(text) changed since the capture';
  end if;
  if (select p.proconfig from pg_proc p where p.oid = to_regprocedure('public.rls_auto_enable()')) is distinct from array['search_path=pg_catalog']::text[] then
    raise exception 'preflight failed: the settings of public.rls_auto_enable() changed since the capture';
  end if;
  if to_regclass('public.owner_contact_access') is not null or to_regprocedure('public.caller_is_admin()') is not null
     or to_regprocedure('public.caller_is_active()') is not null
     or to_regprocedure('public.caller_access_state()') is not null
     or to_regprocedure('public.restore_inactive_account()') is not null
     or exists (select 1 from pg_policies where policyname like 'blocked_account_no_%') then
    raise exception 'preflight failed: hardening objects already exist';
  end if;
  perform 1 from auth.sessions limit 1;   -- the function owner must be able to read auth.sessions (change 2)
end $pre$;

-- ── 1. helpers (change 2, change 3) ──────────────────────────────────────────────────────────────────────────────────────────────────────
-- true only for a LIVE account: the profile row exists (a missing row is no access), it is not deleted, its status gives access, and the session the JWT names exists
create function public.caller_is_active() returns boolean
language sql stable security definer set search_path = public, pg_temp as $$
  select coalesce(
    (select u.deleted_at is null
        and (u.status = 'active' or (u.status = 'blocked' and u.suspended_until is not null and u.suspended_until <= now()))
     from public.users u where u.id = auth.uid())
    and exists (select 1 from auth.sessions s where s.id = nullif(auth.jwt() ->> 'session_id', '')::uuid and s.user_id = auth.uid()),
    false)
$$;
revoke all on function public.caller_is_active() from public, anon;
grant execute on function public.caller_is_active() to authenticated, service_role;

create function public.caller_is_admin() returns boolean
language sql stable security definer set search_path = public, pg_temp as $$
  select public.caller_is_active()
     and exists (select 1 from public.users u where u.id = auth.uid() and u.role = 'admin'::user_role)
$$;
revoke all on function public.caller_is_admin() from public, anon;
grant execute on function public.caller_is_admin() to authenticated, service_role;

-- ── 1b. v5 (R58 (a), change 9): the view public_user_profiles ─────────────────────────────────────────────────────────────────────────────
-- A definer view ignores the RLS of public.users, and the policy loop of section 9 joins pg_tables, which holds no view: without this a blocked, deleted or signed-out-elsewhere account keeps a
-- read path that a guest does not have. CREATE OR REPLACE keeps the owner, the ACL and every dependent; the options are restated (a replace without them would reset them) and both are checked.
create or replace view public.public_user_profiles with (security_invoker=false) as
SELECT id,
    name,
    avatar_url,
    user_type,
    is_verified,
    company_name,
    deleted_at,
    phone IS NOT NULL AND length(phone) > 0 AS has_phone,
    whatsapp IS NOT NULL AND length(whatsapp) > 0 AS has_whatsapp
   FROM users
  where current_user not in ('authenticated', 'anon') or (select public.caller_is_active());
do $view$
begin
  if (select c.relacl::text from pg_class c where c.oid = 'public.public_user_profiles'::regclass) is distinct from '{postgres=arwdDxtm/postgres,service_role=arwdDxtm/postgres,authenticated=r/postgres}' or (select c.reloptions from pg_class c where c.oid = 'public.public_user_profiles'::regclass) is distinct from array['security_invoker=false']::text[] then
    raise exception 'public.public_user_profiles lost its grants or options';
  end if;
end $view$;

-- ── 1c. v5 (R58 (b), change 10): pg_temp on the six SECURITY DEFINER functions v4 left as they were; no body change ──────────────────────────────
alter function public.clear_user_history(text, uuid, uuid, uuid) set search_path = public, pg_temp;
alter function public.handle_new_user_notifications() set search_path = public, pg_temp;
alter function public.listing_contact_events_set_owner() set search_path = public, pg_temp;
alter function public.process_saved_search_notify(timestamp with time zone) set search_path = public, pg_temp;
alter function public.admin_search_users_by_email(text) set search_path = auth, public, pg_temp;
alter function public.rls_auto_enable() set search_path = pg_catalog, pg_temp;

-- ── 2. DBR-1: sign-up can no longer choose the role or the verified flag (change 1: public, pg_temp) ─────────────────────────────────────
create or replace function public.handle_new_user() returns trigger
language plpgsql security definer set search_path = public, pg_temp as $$
declare
  v_type user_type := 'private';
  v_avatar text := new.raw_user_meta_data->>'avatar_url';
begin
  if new.raw_user_meta_data->>'user_type' = 'agent' then v_type := 'agent'; end if;   -- the only choice a sign-up form offers
  if v_avatar is not null and v_avatar !~ '^https://' then v_avatar := null; end if;   -- the value is rendered in <img src>
  insert into public.users (id, name, phone, avatar_url, role, user_type, is_verified, created_at)
  values (
    new.id,
    left(coalesce(new.raw_user_meta_data->>'name', new.raw_user_meta_data->>'full_name', split_part(new.email, '@', 1)), 200),
    left(new.raw_user_meta_data->>'phone', 32),
    left(v_avatar, 2000),
    'user'::user_role,                       -- never from metadata: administrators are made by an administrator with service_role
    v_type,
    false,
    now()
  )
  on conflict (id) do nothing;
  return new;
end $$;

-- ── 3. users guard (S59, S60; change 5: INSERT as well) ──────────────────────────────────────────────────────────────────────────────────
create function public.guard_users_protected_columns() returns trigger
language plpgsql set search_path = public, pg_temp as $$
begin
  -- service_role, the table owner and SECURITY DEFINER functions are trusted; an active administrator acting through a session is too
  if current_user not in ('authenticated', 'anon') or public.caller_is_admin() then return new; end if;
  if tg_op = 'INSERT' then
    -- a session may only ever insert a plain, active, unverified, never-sanctioned user (no policy allows an insert today; this does not depend on that)
    if new.role::text <> 'user'
    or coalesce(new.is_verified, false)
    or coalesce(new.status::text, 'active') <> 'active'
    or new.block_reason is not null
    or new.suspended_until is not null
    or new.deleted_at is not null then
      raise exception 'protected column' using errcode = '42501';
    end if;
    return new;
  end if;
  if new.id is distinct from old.id
  or new.role is distinct from old.role
  or new.is_verified is distinct from old.is_verified
  or new.status is distinct from old.status
  or new.block_reason is distinct from old.block_reason
  or new.suspended_until is distinct from old.suspended_until
  or new.deleted_at is distinct from old.deleted_at
  or new.public_id is distinct from old.public_id then
    raise exception 'protected column' using errcode = '42501';
  end if;
  return new;
end $$;
create trigger users_guard_protected before insert or update on public.users for each row execute function public.guard_users_protected_columns();

-- ── 4. listings guard (S61) ──────────────────────────────────────────────────────────────────────────────────────────────────────────────
-- INSERT from a session must be exactly what createListing sends: status 'pending', not premium, no counters, expiry within the active window.
create function public.guard_listings_protected_columns() returns trigger
language plpgsql set search_path = public, pg_temp as $$
begin
  if current_user not in ('authenticated', 'anon') or public.caller_is_admin() then return new; end if;
  if tg_op = 'INSERT' then
    if new.status is distinct from 'pending'::listing_status
    or coalesce(new.is_premium, false)
    or new.premium_until is not null
    or coalesce(new.views_count, 0) <> 0
    or (new.expires_at is not null and new.expires_at > now() + interval '61 days') then
      raise exception 'protected column' using errcode = '42501';
    end if;
    return new;
  end if;
  if new.is_premium is distinct from old.is_premium
  or new.premium_until is distinct from old.premium_until
  or new.views_count is distinct from old.views_count
  or new.expires_at is distinct from old.expires_at
  or new.public_id is distinct from old.public_id
  or new.user_id is distinct from old.user_id
  or new.status is distinct from old.status then
    raise exception 'protected column' using errcode = '42501';
  end if;
  return new;
end $$;
create trigger listings_guard_protected before insert or update on public.listings for each row execute function public.guard_listings_protected_columns();

-- ── 5. record_listing_view (S62, DBR-3; change 1) ────────────────────────────────────────────────────────────────────────────────────────
drop function public.record_listing_view(uuid, uuid, text);
create function public.record_listing_view(p_listing_id uuid, p_user_id uuid default null, p_ip_hash text default '')
returns boolean language plpgsql security definer set search_path = public, pg_temp as $$
declare
  v_hash text := left(coalesce(p_ip_hash, ''), 64);
begin
  -- same statuses as the view route (src/app/api/listings/[slug]/view/route.ts)
  if not exists (select 1 from listings where id = p_listing_id and status in ('active', 'sold', 'rented', 'archived')) then return false; end if;
  if p_user_id is null and v_hash = '' then return false; end if;   -- nothing to de-duplicate by: not counted
  perform pg_advisory_xact_lock(hashtextextended(p_listing_id::text || '|' || coalesce(p_user_id::text, 'ip:' || v_hash), 0));
  if exists (
    select 1 from listing_views
    where listing_id = p_listing_id and viewed_at >= now() - interval '24 hours'
      and ((p_user_id is not null and user_id = p_user_id) or (p_user_id is null and ip_hash = v_hash))
  ) then return false; end if;
  insert into listing_views (listing_id, user_id, ip_hash, viewed_at) values (p_listing_id, p_user_id, v_hash, now());
  update listings set views_count = views_count + 1 where id = p_listing_id;
  return true;
end $$;
revoke all on function public.record_listing_view(uuid, uuid, text) from public, anon, authenticated;
grant execute on function public.record_listing_view(uuid, uuid, text) to service_role;

-- ── 6. record_recently_viewed (S63; change 1) ────────────────────────────────────────────────────────────────────────────────────────────
create or replace function public.record_recently_viewed(p_listing_id uuid, p_cap integer default 25)
returns void language plpgsql security definer set search_path = public, pg_temp as $$
declare
  v_user_id uuid := auth.uid();
  v_cap integer := least(greatest(coalesce(p_cap, 25), 1), 100);
begin
  if v_user_id is null then raise exception 'unauthenticated'; end if;
  if not public.caller_is_active() then raise exception 'account_blocked' using errcode = '42501'; end if;
  insert into recently_viewed (user_id, listing_id, viewed_at) values (v_user_id, p_listing_id, now())
  on conflict (user_id, listing_id) do update set viewed_at = now();
  delete from recently_viewed
  where user_id = v_user_id
    and id not in (select id from recently_viewed where user_id = v_user_id order by viewed_at desc limit v_cap);
end $$;
revoke all on function public.record_recently_viewed(uuid, integer) from public, anon;
grant execute on function public.record_recently_viewed(uuid, integer) to authenticated, service_role;

-- ── 7. owner contact quota inside the function (S64) ─────────────────────────────────────────────────────────────────────────────────────
create table public.owner_contact_access (
  user_id uuid not null references public.users(id) on delete cascade,
  listing_id uuid not null references public.listings(id) on delete cascade,
  accessed_at timestamptz not null default now(),
  primary key (user_id, listing_id, accessed_at)
);
create index owner_contact_access_user_time on public.owner_contact_access (user_id, accessed_at desc);
alter table public.owner_contact_access enable row level security;      -- no policy: only SECURITY DEFINER code and service_role reach it
revoke all on table public.owner_contact_access from public, anon, authenticated;

-- OWNER (D-quota): replace NULL by the number of DIFFERENT listings one person may open per 24 hours. NULL = unlimited (today's behaviour).
create function public.owner_contact_daily_limit() returns integer language sql immutable as $$ select null::integer $$;

create or replace function public.get_listing_owner_contact(listing_id_param uuid)
returns table(phone text, whatsapp text) language plpgsql security definer set search_path = public, pg_temp as $$
declare
  v_uid uuid := auth.uid();
  v_limit integer := public.owner_contact_daily_limit();
  v_seen boolean;
  v_count integer;
begin
  if v_uid is null then raise exception 'unauthenticated' using errcode = '42501'; end if;
  if not public.caller_is_active() then raise exception 'account_blocked' using errcode = '42501'; end if;
  if not exists (select 1 from public.listings l join public.users u on u.id = l.user_id
                 where l.id = listing_id_param and l.status in ('active', 'sold', 'rented', 'archived') and u.deleted_at is null) then
    return;
  end if;
  if v_limit is not null then
    perform pg_advisory_xact_lock(hashtextextended('owner_contact|' || v_uid::text, 0));
    select exists (select 1 from owner_contact_access a where a.user_id = v_uid and a.listing_id = listing_id_param and a.accessed_at >= now() - interval '24 hours') into v_seen;
    if not v_seen then
      select count(distinct a.listing_id) into v_count from owner_contact_access a where a.user_id = v_uid and a.accessed_at >= now() - interval '24 hours';
      if v_count >= v_limit then raise exception 'rate_limited' using errcode = '54000'; end if;
      insert into owner_contact_access (user_id, listing_id) values (v_uid, listing_id_param);
    end if;
  end if;
  return query
    select u.phone, u.whatsapp from public.listings l join public.users u on u.id = l.user_id
    where l.id = listing_id_param and l.status in ('active', 'sold', 'rented', 'archived') and u.deleted_at is null;
end $$;

-- ── 8. the inactivity state (change 8, owner D28) ────────────────────────────────────────────────────────────────────────────────────────
-- 'active' when caller_is_active(); 'restorable' for an account the inactivity rule marked (deleted_at within 90 days, status inactive) whose session is live; else 'none'
create function public.caller_access_state() returns text
language sql stable security definer set search_path = public, pg_temp as $$
  select case
    when public.caller_is_active() then 'active'
    when exists (
      select 1 from public.users u
      where u.id = auth.uid() and u.status = 'inactive' and u.deleted_at is not null and u.deleted_at > now() - interval '90 days'
        and exists (select 1 from auth.sessions s where s.id = nullif(auth.jwt() ->> 'session_id', '')::uuid and s.user_id = u.id)
    ) then 'restorable'
    else 'none'
  end
$$;
revoke all on function public.caller_access_state() from public, anon;
grant execute on function public.caller_access_state() to authenticated, service_role;

-- exactly the writes of src/app/api/presence/route.ts (the restore branch), for auth.uid() and only when the state is 'restorable'; returns whether it restored
create function public.restore_inactive_account() returns boolean
language plpgsql security definer set search_path = public, pg_temp as $$
declare
  v_uid uuid := auth.uid();
begin
  if v_uid is null or public.caller_access_state() <> 'restorable' then return false; end if;
  update public.users set deleted_at = null, status = 'active', last_seen_at = now(), inactivity_warning_sent_at = null where id = v_uid;
  insert into public.user_status_history (user_id, old_status, new_status, reason, changed_by)
  values (v_uid, 'inactive', 'active', 'reactivated_within_grace_period', null);
  return true;
end $$;
revoke all on function public.restore_inactive_account() from public, anon;
grant execute on function public.restore_inactive_account() to authenticated, service_role;

-- ── 9. D-blocked on the database side (change 4): no read and no write for a blocked / inactive / deleted person, a missing row or an ended session ─
-- RESTRICTIVE policies are AND-ed with the existing permissive ones, so nothing is opened. One per command on every table the signed-in role can read or write
-- (table-level and column-level grants). service_role bypasses RLS, so the admin panel and the server gateway are unaffected.
-- New tables created later are NOT covered automatically: re-run this block (it is idempotent) after adding one.
do $blk$
declare r record; p text;
begin
  for r in
    select distinct t.table_name as tbl, t.priv from (
      select g.table_name, g.privilege_type as priv from information_schema.role_table_grants g
        where g.table_schema = 'public' and g.grantee = 'authenticated' and g.privilege_type in ('SELECT', 'INSERT', 'UPDATE', 'DELETE')
      union
      select c.table_name, c.privilege_type from information_schema.column_privileges c
        where c.table_schema = 'public' and c.grantee = 'authenticated' and c.privilege_type in ('SELECT', 'INSERT', 'UPDATE')
    ) t join pg_tables pt on pt.schemaname = 'public' and pt.tablename = t.table_name
  loop
    p := 'blocked_account_no_' || lower(r.priv);
    execute format('drop policy if exists %I on public.%I', p, r.tbl);
    if r.priv = 'SELECT' then
      execute format('create policy %I on public.%I as restrictive for select to authenticated using ((select public.caller_is_active()))', p, r.tbl);
    elsif r.priv = 'INSERT' then
      execute format('create policy %I on public.%I as restrictive for insert to authenticated with check ((select public.caller_is_active()))', p, r.tbl);
    elsif r.priv = 'UPDATE' then
      execute format('create policy %I on public.%I as restrictive for update to authenticated using ((select public.caller_is_active())) with check ((select public.caller_is_active()))', p, r.tbl);
    else
      execute format('create policy %I on public.%I as restrictive for delete to authenticated using ((select public.caller_is_active()))', p, r.tbl);
    end if;
  end loop;
end $blk$;

-- ── 9b. file storage (change 7): the avatars policies trust a role alone; a blocked or deleted administrator / moderator still wrote there ──
drop policy if exists blocked_account_no_select on storage.objects;
drop policy if exists blocked_account_no_insert on storage.objects;
drop policy if exists blocked_account_no_update on storage.objects;
drop policy if exists blocked_account_no_delete on storage.objects;
create policy blocked_account_no_select on storage.objects as restrictive for select to authenticated using ((select public.caller_is_active()));
create policy blocked_account_no_insert on storage.objects as restrictive for insert to authenticated with check ((select public.caller_is_active()));
create policy blocked_account_no_update on storage.objects as restrictive for update to authenticated using ((select public.caller_is_active())) with check ((select public.caller_is_active()));
create policy blocked_account_no_delete on storage.objects as restrictive for delete to authenticated using ((select public.caller_is_active()));

-- ── 10. S65 ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
revoke truncate on all tables in schema public from anon, authenticated;

notify pgrst, 'reload schema';
commit;
