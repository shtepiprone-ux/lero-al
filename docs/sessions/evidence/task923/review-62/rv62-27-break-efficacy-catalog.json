 "callerIsActive": [
  {
   "def": "CREATE OR REPLACE FUNCTION public.caller_is_active()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\n  select coalesce(\r\n    (select u.deleted_at is null\r\n        and (u.status = 'active' or (u.status = 'blocked' and u.suspended_until is not null and u.suspended_until <= now()))\r\n     from public.users u where u.id = auth.uid())\r\n    and exists (select 1 from auth.sessions s where s.id = nullif(auth.jwt() ->> 'session_id', '')::uuid and s.user_id = auth.uid()),\r\n    false)\r\n$function$\n"
  }
 ],
 "guardListings": [
  {
   "def": "CREATE OR REPLACE FUNCTION public.guard_listings_protected_columns()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\nbegin\r\n  if current_user not in ('authenticated', 'anon') or public.caller_is_admin() then return new; end if;\r\n  if tg_op = 'INSERT' then\r\n    if new.status is distinct from 'pending'::listing_status\r\n    or coalesce(new.is_premium, false)\r\n    or new.premium_until is not null\r\n    or coalesce(new.views_count, 0) <> 0\r\n    or (new.expires_at is not null and new.expires_at > now() + interval '61 days')\r\n    or new.created_at is distinct from now()\r\n    or new.slug is null or new.slug !~ '^[a-z0-9]+(-[a-z0-9]+)*$' or length(new.slug) > 120 then\r\n      raise exception 'protected column' using errcode = '42501';\r\n    end if;\r\n    new.public_id := nextval('public.listings_public_id_seq'::regclass);   -- whatever the client sent: the next value of the sequence\r\n    return new;\r\n  end if;\r\n  if new.is_premium is distinct from old.is_premium\r\n  or new.premium_until is distinct from old.premium_until\r\n  or new.views_count is distinct from old.views_count\r\n  or new.expires_at is distinct from old.expires_at\r\n  or new.public_id is distinct from old.public_id\r\n  or new.user_id is distinct from old.user_id\r\n  or new.status is distinct from old.status\r\n  or new.created_at is distinct from old.created_at\r\n  or new.slug is distinct from old.slug then\r\n    raise exception 'protected column' using errcode = '42501';\r\n  end if;\r\n  return new;\r\nend $function$\n"
  }
 ],
 "guardUsers": [
  {
   "def": "CREATE OR REPLACE FUNCTION public.guard_users_protected_columns()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\nbegin\r\n  -- service_role, the table owner and SECURITY DEFINER functions are trusted; an active administrator acting through a session is too\r\n  if current_user not in ('authenticated', 'anon') or public.caller_is_admin() then return new; end if;\r\n  if tg_op = 'INSERT' then\r\n    -- a session may only ever insert a plain, active, unverified, never-sanctioned user (no policy allows an insert today; this does not depend on that)\r\n    if new.role::text <> 'user'\r\n    or coalesce(new.is_verified, false)\r\n    or coalesce(new.status::text, 'active') <> 'active'\r\n    or new.block_reason is not null\r\n    or new.suspended_until is not null\r\n    or new.deleted_at is not null then\r\n      raise exception 'protected column' using errcode = '42501';\r\n    end if;\r\n    return new;\r\n  end if;\r\n  if new.id is distinct from old.id\r\n  or new.role is distinct from old.role\r\n  or new.is_verified is distinct from old.is_verified\r\n  or new.status is distinct from old.status\r\n  or new.block_reason is distinct from old.block_reason\r\n  or new.suspended_until is distinct from old.suspended_until\r\n  or new.deleted_at is distinct from old.deleted_at\r\n  or new.public_id is distinct from old.public_id then\r\n    raise exception 'protected column' using errcode = '42501';\r\n  end if;\r\n  return new;\r\nend $function$\n"
  }
 ],
