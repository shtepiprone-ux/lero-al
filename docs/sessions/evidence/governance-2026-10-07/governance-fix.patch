--- a/.github/workflows/governance-pr.yml
+++ b/.github/workflows/governance-pr.yml
@@ -20,6 +20,33 @@
       - 'docs/reviews/**'
       - 'messages/**'
       - '.github/workflows/**'
+  # Owner decision 2026-10-07: work reaches main by direct push, so the gate must run on every push
+  # to main, not only on PRs. No PR had been opened since 2026-08-16, which left this whole gate
+  # unexecuted for seven weeks while the weekly scan failed unseen (docs/governance-enforcement.md §9).
+  push:
+    branches: [main]
+    paths:
+      - 'src/**'
+      - 'scripts/**'
+      - 'eslint.config.mjs'
+      - 'package.json'
+      - 'tasks/**'
+      - 'docs/agent-contract.md'
+      - 'docs/orchestrator-procedures.md'
+      - 'docs/orchestrator-role.md'
+      - 'docs/review-ledger.schema.json'
+      - 'docs/review-ledger-template.json'
+      - 'docs/qa-profiles.md'
+      - 'docs/storybook-governance.md'
+      - 'docs/critical-flow-registry.md'
+      - 'docs/reviews/**'
+      - 'messages/**'
+      - '.github/workflows/**'
+
+# A newer push to the same ref supersedes an older run: main's latest commit is what must be green.
+concurrency:
+  group: governance-${{ github.ref }}
+  cancel-in-progress: true
 
 jobs:
   governance:
@@ -49,10 +76,17 @@
